<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/..."
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="view.AddFlightTabController"
      spacing="16"
      stylesheets="@admin_theme.css"
      styleClass="page-container">
    <padding>
        <Insets top="32" right="32" bottom="32" left="32"/>
    </padding>

    <VBox spacing="2">
        <Label text="Add New Flight" styleClass="section-title"/>
        <Label text="Create a new flight record" styleClass="section-subtitle"/>
    </VBox>

    <HBox>
        <VBox spacing="16" styleClass="table-card" prefWidth="720">
            <padding>
                <Insets top="24" right="24" bottom="24" left="24"/>
            </padding>

            <GridPane hgap="16" vgap="12">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50"/>
                    <ColumnConstraints percentWidth="50"/>
                </columnConstraints>

                <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <Label text="Flight ID (Numbers only)" styleClass="form-label"/>
                    <TextField fx:id="flightIdField" styleClass="text-input" promptText="e.g. 201"/>
                </VBox>
                <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <Label text="Carrier" styleClass="form-label"/>
                    <ComboBox fx:id="carrierCombo" styleClass="combo-input" maxWidth="Infinity" promptText="Select Carrier"/>
                </VBox>
            </GridPane>

            <VBox spacing="6">
                <Label text="Aircraft" styleClass="form-label"/>
                <ComboBox fx:id="aircraftCombo" styleClass="combo-input" maxWidth="Infinity" promptText="Select Aircraft"/>
            </VBox>

            <GridPane hgap="16" vgap="12" styleClass="capacity-card">
                <padding>
                    <Insets top="12" right="12" bottom="12" left="12"/>
                </padding>
                <columnConstraints>
                    <ColumnConstraints percentWidth="50"/>
                    <ColumnConstraints percentWidth="50"/>
                </columnConstraints>

                <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <Label text="Economy Seats" styleClass="capacity-title"/>
                    <Label fx:id="economySeatsValue" text="-" styleClass="capacity-value"/>
                </VBox>
                <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <Label text="Business Seats" styleClass="capacity-title"/>
                    <Label fx:id="businessSeatsValue" text="-" styleClass="capacity-value"/>
                </VBox>
            </GridPane>

            <GridPane hgap="16" vgap="12">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50"/>
                    <ColumnConstraints percentWidth="50"/>
                </columnConstraints>

                <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <Label text="Origin City" styleClass="form-label"/>
                    <ComboBox fx:id="originCombo" styleClass="combo-input" maxWidth="Infinity" promptText="Departure City"/>
                </VBox>
                <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <Label text="Destination City" styleClass="form-label"/>
                    <ComboBox fx:id="destinationCombo" styleClass="combo-input" maxWidth="Infinity" promptText="Arrival City"/>
                </VBox>

                <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="1">
                    <Label text="Departure (yyyy-MM-dd HH:mm)" styleClass="form-label"/>
                    <TextField fx:id="departureField" styleClass="text-input" promptText="2026-05-06 08:00"/>
                </VBox>
                <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <Label text="Arrival (yyyy-MM-dd HH:mm)" styleClass="form-label"/>
                    <TextField fx:id="arrivalField" styleClass="text-input" promptText="2026-05-06 11:30"/>
                </VBox>

                <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="2">
                    <Label text="Economy Price ($)" styleClass="form-label"/>
                    <TextField fx:id="economyPriceField" styleClass="text-input" promptText="0.00"/>
                </VBox>
                <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="2">
                    <Label text="Business Price ($)" styleClass="form-label"/>
                    <TextField fx:id="businessPriceField" styleClass="text-input" promptText="0.00"/>
                </VBox>
            </GridPane>

            <HBox spacing="12" alignment="CENTER_RIGHT" styleClass="separator-top">
                <padding>
                    <Insets top="16" right="0" bottom="0" left="0"/>
                </padding>
                <Button fx:id="cancelButton" text="Cancel" onAction="#onCancel" styleClass="secondary-button"/>
                <Button fx:id="saveFlightButton" text="Add Flight" onAction="#onSaveFlight" styleClass="primary-button"/>
            </HBox>
        </VBox>
    </HBox>
</VBox>