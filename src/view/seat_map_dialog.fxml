<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="seatModal"
           fx:controller="view.SeatMapViewController"
           styleClass="modal-overlay"
           xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1">

    <children>
        <VBox spacing="0.0" styleClass="seat-modal-card">
            <children>
                <HBox alignment="CENTER_LEFT" styleClass="seat-modal-header">
                    <padding>
                        <Insets top="12.0" right="18.0" bottom="12.0" left="18.0"/>
                    </padding>
                    <children>
                        <Label text="Seat map" styleClass="modal-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="closeSeatModalButton" text="X" styleClass="btn-icon-plain"/>
                    </children>
                </HBox>

                <VBox spacing="10.0">
                    <padding>
                        <Insets top="14.0" right="18.0" bottom="14.0" left="18.0"/>
                    </padding>
                    <children>
                        <Label fx:id="seatModalTitleLabel" text="Select a seat (Economy)" styleClass="input-label"/>
                        <HBox spacing="16.0">
                            <children>
                                <HBox spacing="6.0" alignment="CENTER_LEFT">
                                    <children>
                                        <Region prefWidth="14.0" prefHeight="14.0" styleClass="legend-available"/>
                                        <Label text="Available" styleClass="legend-label"/>
                                    </children>
                                </HBox>
                                <HBox spacing="6.0" alignment="CENTER_LEFT">
                                    <children>
                                        <Region prefWidth="14.0" prefHeight="14.0" styleClass="legend-occupied"/>
                                        <Label text="Occupied" styleClass="legend-label"/>
                                    </children>
                                </HBox>
                                <HBox spacing="6.0" alignment="CENTER_LEFT">
                                    <children>
                                        <Region prefWidth="14.0" prefHeight="14.0" styleClass="legend-selected"/>
                                        <Label text="Selected" styleClass="legend-label"/>
                                    </children>
                                </HBox>
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <ScrollPane fx:id="seatGridScroll" fitToWidth="true" fitToHeight="false" styleClass="seat-grid-scroll" VBox.vgrow="ALWAYS">
                    <content>
                        <!-- TEAM TODO: generate seat grid with button nodes -->
                        <VBox fx:id="seatGridContainer" spacing="8.0">
                            <padding>
                                <Insets top="8.0" right="18.0" bottom="8.0" left="18.0"/>
                            </padding>
                        </VBox>
                    </content>
                </ScrollPane>

                <HBox spacing="10.0" styleClass="seat-modal-footer">
                    <padding>
                        <Insets top="12.0" right="18.0" bottom="12.0" left="18.0"/>
                    </padding>
                    <children>
                        <Button fx:id="cancelSeatSelectionButton" text="Cancel" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="btn-outline"/>
                        <!-- TEAM TODO: enable only after a seat is selected -->
                        <Button fx:id="seatOkButton" text="OK" disable="true" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="btn-primary"/>
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</StackPane>
