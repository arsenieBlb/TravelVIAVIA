<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           prefWidth="1365"
           prefHeight="768"
           stylesheets="@admin_theme.css"
           styleClass="modal-overlay">

    <ScrollPane fitToWidth="true"
                hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED"
                maxWidth="1160"
                styleClass="modal-scroll">
        <content>
            <VBox spacing="16" styleClass="modal-card">
                <padding>
                    <Insets top="22" right="22" bottom="20" left="22"/>
                </padding>

                <HBox alignment="TOP_LEFT">
                    <VBox spacing="3">
                        <Label fx:id="bookingTitleLabel" text="Booking BK001" styleClass="modal-header-title"/>
                        <Label fx:id="bookingMetaLabel" text="john.doe@example.com - 2 passengers - One Way" styleClass="modal-header-subtitle"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="closeTopButton" text="x" styleClass="close-icon-button"/>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="->" styleClass="section-title-small"/>
                    <Label text="Flight Itinerary" styleClass="section-title-small"/>
                </HBox>

                <HBox spacing="24" alignment="CENTER_LEFT" styleClass="timeline-card">
                    <VBox spacing="4" alignment="CENTER">
                        <Label fx:id="outboundOriginCodeLabel" text="JFK" styleClass="timeline-code"/>
                        <Label fx:id="outboundOriginTimeLabel" text="08:00 AM" styleClass="timeline-time"/>
                    </VBox>

                    <HBox spacing="8" alignment="CENTER">
                        <Region styleClass="timeline-line"/>
                        <VBox spacing="2" alignment="CENTER">
                            <Label fx:id="outboundFlightCodeLabel" text="AA101" styleClass="timeline-mid"/>
                            <Label fx:id="outboundDurationLabel" text="3h 30m" styleClass="timeline-time"/>
                        </VBox>
                        <Region styleClass="timeline-line"/>
                    </HBox>

                    <VBox spacing="4" alignment="CENTER">
                        <Label fx:id="outboundDestinationCodeLabel" text="LAX" styleClass="timeline-code"/>
                        <Label fx:id="outboundArrivalTimeLabel" text="11:30 AM" styleClass="timeline-time"/>
                    </VBox>

                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="outboundTotalDurationLabel" text="Total: 3h 30m" styleClass="timeline-mid"/>
                </HBox>

                <Label text="FLIGHT DETAILS" styleClass="section-title-caps"/>
                <VBox spacing="10" styleClass="details-card">
                    <HBox alignment="TOP_LEFT">
                        <VBox spacing="2">
                            <Label fx:id="detailFlightCodeLabel" text="AA101" styleClass="details-title"/>
                            <Label fx:id="detailCarrierAircraftLabel" text="American Airlines - Boeing 737" styleClass="details-caption"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <VBox spacing="2" alignment="TOP_RIGHT">
                            <Label fx:id="detailPriceLabel" text="$560" styleClass="details-title"/>
                            <Label fx:id="detailDurationLabel" text="3h 30m" styleClass="details-caption"/>
                        </VBox>
                    </HBox>

                    <HBox alignment="CENTER_LEFT" spacing="22">
                        <VBox spacing="2">
                            <Label fx:id="detailOriginCodeLabel" text="JFK" styleClass="details-caption"/>
                            <Label fx:id="detailDepartureLabel" text="Feb 20 08:00 AM" styleClass="details-title"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="->" styleClass="details-caption"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <VBox spacing="2" alignment="TOP_RIGHT">
                            <Label fx:id="detailDestinationCodeLabel" text="LAX" styleClass="details-caption"/>
                            <Label fx:id="detailArrivalLabel" text="Feb 20 11:30 AM" styleClass="details-title"/>
                        </VBox>
                    </HBox>

                    <HBox styleClass="row-divider"/>

                    <HBox spacing="20" alignment="CENTER_LEFT">
                        <Label text="Passenger" styleClass="details-caption" HBox.hgrow="ALWAYS"/>
                        <Label text="Class" styleClass="details-caption" HBox.hgrow="ALWAYS"/>
                        <Label text="Seat" styleClass="details-caption"/>
                    </HBox>
                    <HBox styleClass="row-divider"/>
                    <HBox spacing="20" alignment="CENTER_LEFT">
                        <Label text="John Doe" styleClass="details-title" HBox.hgrow="ALWAYS"/>
                        <Label text="economy" styleClass="chip" HBox.hgrow="ALWAYS"/>
                        <Label text="E25" styleClass="details-title"/>
                    </HBox>
                    <HBox styleClass="row-divider"/>
                    <HBox spacing="20" alignment="CENTER_LEFT">
                        <Label text="Jane Doe" styleClass="details-title" HBox.hgrow="ALWAYS"/>
                        <Label text="economy" styleClass="chip" HBox.hgrow="ALWAYS"/>
                        <Label text="E26" styleClass="details-title"/>
                    </HBox>
                </VBox>

                <HBox styleClass="separator-line"/>
                <Label text="Passengers" styleClass="section-title-small"/>

                <VBox spacing="10">
                    <HBox spacing="20" alignment="CENTER_LEFT" styleClass="card-grid-item">
                        <VBox spacing="3" HBox.hgrow="ALWAYS">
                            <Label text="PASSENGER 1" styleClass="section-title-caps"/>
                            <Label text="John Doe" styleClass="details-title"/>
                        </VBox>
                        <VBox spacing="3" HBox.hgrow="ALWAYS">
                            <Label text="CARRY-ON" styleClass="section-title-caps"/>
                            <Label text="1" styleClass="details-title"/>
                        </VBox>
                        <VBox spacing="3" HBox.hgrow="ALWAYS">
                            <Label text="CHECKED BAGS" styleClass="section-title-caps"/>
                            <Label text="1 bag" styleClass="details-title"/>
                        </VBox>
                    </HBox>

                    <HBox spacing="20" alignment="CENTER_LEFT" styleClass="card-grid-item">
                        <VBox spacing="3" HBox.hgrow="ALWAYS">
                            <Label text="PASSENGER 2" styleClass="section-title-caps"/>
                            <Label text="Jane Doe" styleClass="details-title"/>
                        </VBox>
                        <VBox spacing="3" HBox.hgrow="ALWAYS">
                            <Label text="CARRY-ON" styleClass="section-title-caps"/>
                            <Label text="1" styleClass="details-title"/>
                        </VBox>
                        <VBox spacing="3" HBox.hgrow="ALWAYS">
                            <Label text="CHECKED BAGS" styleClass="section-title-caps"/>
                            <Label text="1 bag" styleClass="details-title"/>
                        </VBox>
                    </HBox>
                </VBox>

                <HBox styleClass="separator-line"/>
                <Label text="Fare Summary" styleClass="section-title-small"/>

                <VBox spacing="10">
                    <VBox spacing="8" styleClass="details-card">
                        <Label text="FLIGHT CHARGES" styleClass="section-title-caps"/>
                        <HBox alignment="CENTER_LEFT">
                            <Label text="AA101 - 2 passengers" styleClass="details-caption"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label text="$560" styleClass="details-title"/>
                        </HBox>
                    </VBox>

                    <VBox spacing="8" styleClass="details-card">
                        <Label text="BAGGAGE FEES" styleClass="section-title-caps"/>
                        <HBox alignment="CENTER_LEFT">
                            <Label text="John Doe - Checked" styleClass="details-caption"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label text="$30" styleClass="details-title"/>
                        </HBox>
                        <HBox styleClass="row-divider"/>
                        <HBox alignment="CENTER_LEFT">
                            <Label text="Jane Doe - Checked" styleClass="details-caption"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label text="$90" styleClass="details-title"/>
                        </HBox>
                    </VBox>

                    <HBox alignment="CENTER_LEFT" styleClass="summary-total">
                        <Label text="Total Amount" styleClass="total-text"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="totalAmountLabel" text="$680" styleClass="total-value"/>
                    </HBox>
                </VBox>

                <HBox spacing="10" alignment="CENTER_RIGHT" styleClass="separator-line">
                    <padding>
                        <Insets top="12" right="0" bottom="0" left="0"/>
                    </padding>
                    <Button fx:id="closeBottomButton" text="Close" styleClass="primary-button"/>
                </HBox>
            </VBox>
        </content>
    </ScrollPane>
</StackPane>


