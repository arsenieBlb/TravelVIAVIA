<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="800.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.view.DashboardViewController">
    <children>
        <VBox layoutX="25.0" layoutY="25.0" spacing="5.0">
            <children>
                <Label text="Dashboard">
                    <font>
                        <Font name="System Bold" size="24.0" />
                    </font>
                </Label>
                <Label text="Manage worldwide flight operations" textFill="#797979">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>
            </children>
        </VBox>

        <HBox layoutX="25.0" layoutY="120.0" spacing="20.0" AnchorPane.leftAnchor="25.0" AnchorPane.rightAnchor="25.0">
            <children>
                <VBox prefHeight="120.0" prefWidth="230.0" spacing="10.0" style="-fx-border-color: #E0E0E0; -fx-border-radius: 8; -fx-background-color: #F9F9F9; -fx-background-radius: 8;">
                    <children>
                        <Label text="✈  Total Flights" textFill="#5a5a5a" />
                        <Label fx:id="totalFlightsLabel" text="0">
                            <font>
                                <Font name="System Bold" size="32.0" />
                            </font>
                        </Label>
                    </children>
                    <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                    </padding>
                </VBox>

                <VBox prefHeight="120.0" prefWidth="230.0" spacing="10.0" style="-fx-border-color: #E0E0E0; -fx-border-radius: 8; -fx-background-color: #F9F9F9; -fx-background-radius: 8;">
                    <children>
                        <Label text="🎫  Active Bookings" textFill="#5a5a5a" />
                        <Label fx:id="activeBookingsLabel" text="0">
                            <font>
                                <Font name="System Bold" size="32.0" />
                            </font>
                        </Label>
                    </children>
                    <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                    </padding>
                </VBox>

                <VBox prefHeight="120.0" prefWidth="230.0" spacing="10.0" style="-fx-border-color: #E0E0E0; -fx-border-radius: 8; -fx-background-color: #F9F9F9; -fx-background-radius: 8;">
                    <children>
                        <Label text="👥  Total Passengers" textFill="#5a5a5a" />
                        <Label fx:id="totalPassengersLabel" text="0">
                            <font>
                                <Font name="System Bold" size="32.0" />
                            </font>
                        </Label>
                    </children>
                    <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                    </padding>
                </VBox>
            </children>
        </HBox>
    </children>
</AnchorPane>
