<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      spacing="16"
      stylesheets="@admin-theme.css"
      styleClass="page-container">
    <padding>
        <Insets top="32" right="32" bottom="32" left="32"/>
    </padding>

    <VBox spacing="2">
        <Label text="Flight Management" styleClass="section-title"/>
        <Label text="Add, edit, remove flights" styleClass="section-subtitle"/>
    </VBox>

    <HBox alignment="CENTER_RIGHT">
        <Button fx:id="addFlightButton" text="+ Add Flight" styleClass="primary-button"/>
    </HBox>

    <VBox spacing="12" styleClass="panel-card">
        <padding>
            <Insets top="16" right="16" bottom="16" left="16"/>
        </padding>

        <FlowPane hgap="8" vgap="8" prefWrapLength="980">
            <VBox spacing="4">
                <Label text="Origin" styleClass="label-filter"/>
                <TextField fx:id="originFilterField" promptText="Any" styleClass="text-input" prefWidth="112"/>
            </VBox>
            <VBox spacing="4">
                <Label text="Destination" styleClass="label-filter"/>
                <TextField fx:id="destinationFilterField" promptText="Any" styleClass="text-input" prefWidth="112"/>
            </VBox>
            <VBox spacing="4">
                <Label text="Aircraft" styleClass="label-filter"/>
                <ComboBox fx:id="aircraftFilterCombo" styleClass="combo-input" prefWidth="132">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="All"/>
                            <String fx:value="Boeing 737"/>
                            <String fx:value="Boeing 787"/>
                            <String fx:value="Airbus A320"/>
                            <String fx:value="Airbus A350"/>
                            <String fx:value="Embraer E190"/>
                        </FXCollections>
                    </items>
                </ComboBox>
            </VBox>
            <VBox spacing="4">
                <Label text="Carrier" styleClass="label-filter"/>
                <TextField fx:id="carrierFilterField" promptText="Any" styleClass="text-input" prefWidth="112"/>
            </VBox>
            <VBox spacing="4">
                <Label text="Date" styleClass="label-filter"/>
                <DatePicker fx:id="dateFilterPicker" styleClass="date-input" prefWidth="148"/>
            </VBox>
            <VBox spacing="4" alignment="BOTTOM_LEFT">
                <Label text="" opacity="0"/>
                <Button fx:id="clearFiltersButton" text="Clear" styleClass="link-button"/>
            </VBox>
        </FlowPane>
    </VBox>

    <StackPane styleClass="table-card" VBox.vgrow="ALWAYS">
        <TableView fx:id="flightsTable" styleClass="data-table">
            <columns>
                <TableColumn fx:id="flightIdColumn" text="FLIGHT ID" prefWidth="120"/>
                <TableColumn fx:id="carrierColumn" text="CARRIER" prefWidth="220"/>
                <TableColumn fx:id="aircraftColumn" text="AIRCRAFT" prefWidth="170"/>
                <TableColumn fx:id="routeColumn" text="ROUTE" prefWidth="190"/>
                <TableColumn fx:id="departureColumn" text="DEPARTURE" prefWidth="170"/>
                <TableColumn fx:id="arrivalColumn" text="ARRIVAL" prefWidth="170"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_SUBSEQUENT_COLUMNS"/>
            </columnResizePolicy>
        </TableView>
        <Label fx:id="flightsEmptyLabel"
               text="No flights found. Add your first flight!"
               styleClass="empty-text"
               visible="false"
               managed="false"/>
    </StackPane>
</VBox>
