<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.DatePicker?>
<HBox fx:id="admin"
      fx:controller="view.FlightsTabViewController"
      prefWidth="1010" prefHeight="568"
      stylesheets="@admin_theme.css"
      styleClass="app-shell"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1">

    <VBox fx:id="sidebarRoot" minWidth="256" prefWidth="256" maxWidth="256" styleClass="sidebar">
        <VBox styleClass="sidebar-header">
            <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>
            <HBox alignment="CENTER_LEFT" spacing="12">
                <StackPane styleClass="logo-box">
                    <Label text="VIA" styleClass="logo-plane"/>
                </StackPane>
                <VBox spacing="2">
                    <Label text="Travel via VIA" styleClass="brand-title"/>
                    <Label text="book flights worldwide" styleClass="brand-subtitle"/>
                </VBox>
            </HBox>
        </VBox>

        <VBox spacing="8" styleClass="sidebar-nav">
            <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
            <Button fx:id="dashboardNavButton" text="Dashboard" maxWidth="Infinity" styleClass="sidebar-link"/>
            <Button fx:id="flightsNavButton" text="Flights" maxWidth="Infinity">
                <styleClass>
                    <String fx:value="sidebar-link"/>
                    <String fx:value="sidebar-link-active"/>
                </styleClass>
            </Button>
            <Button fx:id="bookingsNavButton" text="Bookings" maxWidth="Infinity" styleClass="sidebar-link"/>
        </VBox>
        <Region VBox.vgrow="ALWAYS"/>
    </VBox>
    <VBox HBox.hgrow="ALWAYS" spacing="0" styleClass="main-host">
        <padding>
            <Insets top="32" right="32" bottom="8" left="32"/>
        </padding>
        <HBox alignment="CENTER_LEFT" spacing="20">
            <VBox spacing="2" HBox.hgrow="ALWAYS">
                <Label text="Flight Management" styleClass="section-title"
                    style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
                <Label text="Add, edit, remove flights" styleClass="section-subtitle"
                    style="-fx-text-fill: #64748b;"/>
            </VBox>
            <HBox alignment="CENTER" spacing="15">
                <Label fx:id="authStatusLabel" text="Logged in as Admin"
                    style="-fx-text-fill: #1e293b; -fx-font-size: 13px;"/>

                <HBox onMouseClicked="#onLogoutClick" alignment="CENTER" style="-fx-background-color: black; -fx-background-radius: 8; -fx-cursor: hand;">
                    <padding>
                        <Insets left="15" right="15" top="8" bottom="8"/>
                    </padding>
                    <Label text="Logout" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 12px;"/>
                </HBox>
            </HBox>
        </HBox>

        <StackPane fx:id="contentHost" styleClass="main-host" HBox.hgrow="ALWAYS">
            <StackPane fx:id="dashboardView" visible="false" managed="false" />

            <VBox fx:id="flightsView" spacing="16" styleClass="page-container">
                <padding><Insets top="32" right="32" bottom="16" left="32"/></padding>

                <HBox alignment="CENTER_RIGHT">
                    <Button fx:id="addFlightButton"
                        text="+ Add Flight"
                        onAction="#onAddFlightClick"
                        styleClass="primary-button"/>
                </HBox>

                <VBox spacing="12" styleClass="panel-card">
                    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                    <FlowPane hgap="12" vgap="12" alignment="CENTER_LEFT">
                        <VBox spacing="4">
                            <Label text="Origin" styleClass="label-filter"/>
                            <TextField fx:id="originFilterField" promptText="Any" prefWidth="150" maxWidth="150" styleClass="filter-input"/>
                        </VBox>
                        <VBox spacing="4">
                            <Label text="Destination" styleClass="label-filter"/>
                            <TextField fx:id="destinationFilterField" promptText="Any" prefWidth="150" maxWidth="150" styleClass="filter-input"/>
                        </VBox>
                        <VBox spacing="4">
                            <Label text="Aircraft" styleClass="label-filter"/>
                            <ComboBox fx:id="aircraftFilterCombo"
                                   promptText="All"
                                   prefWidth="150"
                                   maxWidth="150"
                                   styleClass="filter-input"/>
                        </VBox>
                        <VBox spacing="4">
                            <Label text="Carrier" styleClass="label-filter"/>
                            <TextField fx:id="carrierFilterField" promptText="Any" prefWidth="150" maxWidth="150" styleClass="filter-input"/>
                        </VBox>
                        <VBox spacing="4">
                            <Label text="Date" styleClass="label-filter"/>
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <DatePicker fx:id="dateFilterPicker" promptText="dd/mm/yyyy" prefWidth="150" maxWidth="150" styleClass="filter-input"/>
                                <Button text="Clear" onAction="#clearAllFilters" styleClass="text-button-link"/>
                            </HBox>
                        </VBox>
                    </FlowPane>
                </VBox>

                <TableView fx:id="flightsTable" VBox.vgrow="ALWAYS" styleClass="data-table">
                    <columns>
                        <TableColumn fx:id="flightIdColumn" text="FLIGHT ID" prefWidth="120"/>
                        <TableColumn fx:id="carrierColumn" text="CARRIER" prefWidth="220"/>
                        <TableColumn fx:id="aircraftColumn" text="AIRCRAFT" prefWidth="170"/>
                        <TableColumn fx:id="routeColumn" text="ROUTE" prefWidth="190"/>
                        <TableColumn fx:id="departureColumn" text="DEPARTURE" prefWidth="170"/>
                        <TableColumn fx:id="arrivalColumn" text="ARRIVAL" prefWidth="170"/>
                    </columns>
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                </TableView>
            </VBox>

            <StackPane fx:id="bookingsView" visible="false" managed="false">
                <fx:include fx:id="bookingAdminView" source="booking_view_admin.fxml"/>
            </StackPane>
        </StackPane>
    </VBox>
</HBox>
