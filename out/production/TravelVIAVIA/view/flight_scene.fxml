<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import java.lang.String?>

<StackPane fx:id="root"
           fx:controller="view.FlightSceneViewController"
           prefWidth="1440.0"
           prefHeight="920.0"
           stylesheets="@flight_scene.css"
           xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1">

    <children>
        <BorderPane styleClass="app-root">
            <top>
                <VBox>
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="18.0" styleClass="header-bar">
                            <padding>
                                <Insets top="18.0" right="34.0" bottom="18.0" left="34.0"/>
                            </padding>
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="12.0">
                                    <children>
                                        <StackPane prefWidth="48.0" prefHeight="48.0" styleClass="logo-box">
                                            <children>
                                                <Label text="VIA" styleClass="logo-text"/>
                                            </children>
                                        </StackPane>
                                        <VBox spacing="2.0">
                                            <children>
                                                <!-- TEAM TODO: bind this to vm.pageTitle -->
                                                <Label fx:id="pageTitleLabel" text="Travel via VIA" styleClass="title-large"/>
                                                <Label text="Book flights worldwide" styleClass="subtle-caption"/>
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>

                                <Region HBox.hgrow="ALWAYS"/>

                                <HBox alignment="CENTER_RIGHT" spacing="12.0">
                                    <children>
                                        <!-- TEAM TODO: bind auth status text -->
                                        <Label fx:id="authStatusLabel" text="Not signed in" styleClass="auth-status"/>
                                        <!-- TEAM TODO: wire Login/Sign Out action -->
                                        <Button fx:id="authButton" text="Login" styleClass="btn-primary"/>
                                    </children>
                                </HBox>
                            </children>
                        </HBox>

                        <HBox alignment="CENTER_LEFT" spacing="30.0" styleClass="tab-bar">
                            <padding>
                                <Insets top="0.0" right="34.0" bottom="0.0" left="34.0"/>
                            </padding>
                            <children>
                                <!-- TEAM TODO: switch content stack to Book view -->
                                <Button fx:id="bookTabButton" text="BOOK A FLIGHT">
                                    <styleClass>
                                        <String fx:value="tab-btn"/>
                                        <String fx:value="tab-btn-active"/>
                                    </styleClass>
                                </Button>
                                <!-- TEAM TODO: switch content stack to Bookings view -->
                                <Button fx:id="bookingsTabButton" text="MY BOOKINGS" styleClass="tab-btn"/>
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </top>

            <center>
                <StackPane fx:id="contentStack">
                    <children>
                        <StackPane fx:id="bookViewWrapper">
                            <children>
                                <fx:include fx:id="bookView" source="book_flight_view.fxml"/>
                            </children>
                        </StackPane>
                        <StackPane fx:id="bookingsViewWrapper" visible="false" managed="false">
                            <children>
                                <fx:include fx:id="bookingsView" source="my_bookings_view.fxml"/>
                            </children>
                        </StackPane>
                        <StackPane fx:id="passengerViewWrapper" visible="false" managed="false">
                            <children>
                                <fx:include fx:id="passengerView" source="passenger_details_view.fxml"/>
                            </children>
                        </StackPane>
                    </children>
                </StackPane>
            </center>
        </BorderPane>

        <!-- TEAM TODO: show only when bookings screen is active -->
        <Button fx:id="floatingAddBookingButton"
                text="+"
                styleClass="floating-btn"
                visible="false"
                managed="false"
                StackPane.alignment="BOTTOM_RIGHT">
            <StackPane.margin>
                <Insets right="34.0" bottom="30.0"/>
            </StackPane.margin>
        </Button>

        <StackPane fx:id="addBookingDialogWrapper" visible="false" managed="false">
            <children>
                <fx:include fx:id="addBookingDialog" source="add_booking_dialog.fxml"/>
            </children>
        </StackPane>
        <StackPane fx:id="loginDialogWrapper" visible="false" managed="false">
            <children>
                <fx:include fx:id="loginDialog" source="login_dialog.fxml"/>
            </children>
        </StackPane>
        <StackPane fx:id="registerDialogWrapper" visible="false" managed="false">
            <children>
                <fx:include fx:id="registerDialog" source="register_dialog.fxml"/>
            </children>
        </StackPane>
        <StackPane fx:id="adminLoginDialogWrapper" visible="false" managed="false">
            <children>
                <fx:include fx:id="adminLoginDialog" source="admin_login_dialog.fxml"/>
            </children>
        </StackPane>
        <StackPane fx:id="verificationDialogWrapper" visible="false" managed="false">
            <children>
                <fx:include fx:id="verificationDialog" source="email_verification_dialog.fxml"/>
            </children>
        </StackPane>
        <StackPane fx:id="cancellationDialogWrapper" visible="false" managed="false">
            <children>
                <fx:include fx:id="cancellationDialog" source="cancellation_dialog.fxml"/>
            </children>
        </StackPane>
        <StackPane fx:id="bookingDetailsDialogWrapper" visible="false" managed="false">
            <children>
                <fx:include fx:id="bookingDetailsDialog" source="booking_details_dialog.fxml"/>
            </children>
        </StackPane>
        <StackPane fx:id="seatMapDialogWrapper" visible="false" managed="false">
            <children>
                <fx:include fx:id="seatMapDialog" source="seat_map_dialog.fxml"/>
            </children>
        </StackPane>
    </children>
</StackPane>

